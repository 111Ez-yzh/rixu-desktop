<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <FontFamily x:Key="deskFont">Segoe UI, Microsoft YaHei UI, Microsoft YaHei, YouYuan</FontFamily>
 <Style x:Key="{x:Static SystemParameters.FocusVisualStyleKey}" TargetType="Control">
  <Setter Property="Template"><Setter.Value><ControlTemplate><Border CornerRadius="10" BorderBrush="#7087AA" BorderThickness="1.5" Margin="1" IsHitTestVisible="False"/></ControlTemplate></Setter.Value></Setter>
 </Style>
 <LinearGradientBrush x:Key="glassGlaze" StartPoint=".46,0" EndPoint=".54,1">
  <GradientStop Color="#69FFFFFF"/><GradientStop Color="#1EFFFFFF" Offset=".35"/>
  <GradientStop Color="#02FFFFFF" Offset=".64"/><GradientStop Color="#167C92BA" Offset="1"/>
 </LinearGradientBrush>
 <LinearGradientBrush x:Key="glassRim" StartPoint=".3,0" EndPoint=".7,1">
  <GradientStop Color="#FFFFFFFF"/><GradientStop Color="#BAFFFFFF" Offset=".25"/>
  <GradientStop Color="#5F9FAECC" Offset=".70"/><GradientStop Color="#897E90AC" Offset="1"/>
 </LinearGradientBrush>
 <RadialGradientBrush x:Key="glassGlint" Center=".32,.14" GradientOrigin=".32,.14" RadiusX=".62" RadiusY="1.1">
  <GradientStop Color="White"/><GradientStop Color="#9AC5DDFF" Offset=".45"/><GradientStop Color="#00CDDEFF" Offset="1"/>
 </RadialGradientBrush>
 <DropShadowEffect x:Key="glassShadow" Color="#34425F" Direction="270" Opacity=".27" ShadowDepth="2" BlurRadius="5"/>
 <ControlTemplate x:Key="glassButton" TargetType="Button">
  <Grid Background="Transparent">
   <Border x:Name="contact" CornerRadius="18" BorderBrush="#A43B4F71" BorderThickness="2" Margin="1,1,1,0" Effect="{StaticResource glassShadow}" IsHitTestVisible="False"/>
   <Grid x:Name="MotionSurface" RenderTransformOrigin=".5,.5">
    <Border CornerRadius="18" BorderBrush="#87697A94" BorderThickness="1,0,1,2" Margin="0,2,0,0"/>
    <Grid x:Name="lens" Margin="0,0,0,1.5">
     <Border CornerRadius="18" Background="{TemplateBinding Background}" Opacity=".93"/>
     <Border CornerRadius="18" Background="{StaticResource glassGlaze}" BorderBrush="{StaticResource glassRim}" BorderThickness="1"/>
     <Border CornerRadius="17" Margin="1" BorderBrush="#43FFFFFF" BorderThickness="1,.5,1,1"/>
     <Border x:Name="MotionTint" CornerRadius="17" Margin="1" Background="{StaticResource glassGlint}" Opacity="0" IsHitTestVisible="False"/>
     <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"/>
    </Grid>
   </Grid>
  </Grid>
  <ControlTemplate.Triggers>
   <Trigger Property="IsPressed" Value="True"><Setter TargetName="contact" Property="Opacity" Value=".36"/><Setter TargetName="lens" Property="Margin" Value="0,1,0,.5"/></Trigger>
   <Trigger Property="IsEnabled" Value="False"><Setter TargetName="contact" Property="Visibility" Value="Hidden"/><Setter TargetName="MotionSurface" Property="Opacity" Value=".48"/></Trigger>
  </ControlTemplate.Triggers>
 </ControlTemplate>
 <Style TargetType="Button">
  <Setter Property="Template" Value="{StaticResource glassButton}"/>
  <Setter Property="FontWeight" Value="SemiBold"/>
  <Setter Property="Background" Value="#DDE5EFFB"/><Setter Property="Foreground" Value="#242B37"/>
  <Setter Property="Padding" Value="15,8"/><Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Center"/>
 </Style>
 <LinearGradientBrush x:Key="widgetFrost" StartPoint="0,0" EndPoint=".82,1">
  <GradientStop Color="#83FBFCFF"/><GradientStop Color="#59F5F7FD" Offset=".54"/><GradientStop Color="#6AE8EDF5" Offset="1"/>
 </LinearGradientBrush>
 <LinearGradientBrush x:Key="widgetEdge" StartPoint=".3,0" EndPoint=".7,1">
  <GradientStop Color="#C4FFFFFF"/><GradientStop Color="#62FFFFFF" Offset=".42"/><GradientStop Color="#31616F85" Offset="1"/>
 </LinearGradientBrush>
 <LinearGradientBrush x:Key="widgetToolbar" StartPoint="0,0" EndPoint=".25,1">
  <GradientStop Color="#A3FFFFFF"/><GradientStop Color="#68FCFDFF" Offset=".48"/><GradientStop Color="#4DEBF0F8" Offset="1"/>
 </LinearGradientBrush>
 <Style x:Key="widgetAction" TargetType="Button">
  <Setter Property="Height" Value="30"/><Setter Property="MinWidth" Value="30"/>
  <Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/>
  <Setter Property="Foreground" Value="#293544"/><Setter Property="Cursor" Value="Hand"/>
  <Setter Property="Padding" Value="4,0"/><Setter Property="Template"><Setter.Value>
   <ControlTemplate TargetType="Button">
    <Grid Background="Transparent">
     <Grid x:Name="MotionSurface" RenderTransformOrigin=".5,.5">
      <Border x:Name="MotionTint" Margin="1" CornerRadius="14" Background="#ACC4DD" Opacity="0"/>
      <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Grid>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="MotionSurface" Property="Opacity" Value=".45"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate>
  </Setter.Value></Setter>
 </Style>
 <Style x:Key="captionAction" TargetType="Button">
  <Setter Property="Width" Value="30"/><Setter Property="Height" Value="26"/><Setter Property="Margin" Value="2,0"/>
  <Setter Property="Background" Value="#E9EBF0"/><Setter Property="Cursor" Value="Hand"/>
  <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
   <Grid Background="Transparent"><Border x:Name="MotionSurface" Width="24" Height="24" CornerRadius="12" Background="{TemplateBinding Background}" RenderTransformOrigin=".5,.5">
    <Grid><Ellipse Fill="{StaticResource glassGlaze}" Stroke="{StaticResource glassRim}"/><Ellipse x:Name="MotionTint" Fill="#CBD9EF" Opacity="0"/><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
   </Border></Grid>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <CornerRadius x:Key="windowFrameRadius">22</CornerRadius>
 <ControlTemplate x:Key="deskFrame" TargetType="Window">
  <Grid Background="{TemplateBinding Background}">
  <Border x:Name="frame" CornerRadius="{StaticResource windowFrameRadius}" Background="{TemplateBinding Background}" BorderBrush="#C9CCD7" BorderThickness="1">
   <Grid><Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition/></Grid.RowDefinitions>
    <DockPanel Margin="20,0,12,0">
     <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
      <Button x:Name="frameMin" Style="{StaticResource captionAction}" Command="{x:Static SystemCommands.MinimizeWindowCommand}" ToolTip="{DynamicResource ui.winMin}" AutomationProperties.Name="{DynamicResource ui.winMin}">
       <Path Data="M1,5 L9,5" Stroke="#576278" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
      </Button>
      <Button x:Name="frameMax" Style="{StaticResource captionAction}" Command="{x:Static SystemCommands.MaximizeWindowCommand}" ToolTip="{DynamicResource ui.winMax}" AutomationProperties.Name="{DynamicResource ui.winMax}">
       <Grid Width="10" Height="10"><Rectangle x:Name="maxGlyph" Width="9" Height="9" RadiusX="2" RadiusY="2" Stroke="#576278" StrokeThickness="1.3"/>
        <Path x:Name="restoreGlyph" Data="M3,2 Q3,1 4,1 H8 Q9,1 9,2 V6 M2,4 H6 Q7,4 7,5 V8 Q7,9 6,9 H2 Q1,9 1,8 V5 Q1,4 2,4" Stroke="#576278" StrokeThickness="1.2" Visibility="Collapsed"/></Grid>
      </Button>
      <Button x:Name="frameClose" Style="{StaticResource captionAction}" Background="#EFDFD8" Command="{x:Static SystemCommands.CloseWindowCommand}" ToolTip="{DynamicResource ui.winClose}" AutomationProperties.Name="{DynamicResource ui.winClose}">
       <Path Data="M1,1 L8,8 M8,1 L1,8" Stroke="#7A5148" StrokeThickness="1.35" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
      </Button>
     </StackPanel>
     <TextBlock Text="{TemplateBinding Title}" Foreground="#626B79" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
    </DockPanel>
    <AdornerDecorator Grid.Row="1"><ContentPresenter ContentSource="Content"/></AdornerDecorator>
   </Grid>
  </Border>
  </Grid>
  <ControlTemplate.Triggers>
   <Trigger Property="WindowState" Value="Maximized">
    <Setter TargetName="frame" Property="CornerRadius" Value="0"/>
    <Setter TargetName="frame" Property="BorderThickness" Value="0"/>
    <Setter TargetName="frameMax" Property="Command" Value="{x:Static SystemCommands.RestoreWindowCommand}"/>
    <Setter TargetName="frameMax" Property="ToolTip" Value="{DynamicResource ui.winRestore}"/>
    <Setter TargetName="frameMax" Property="AutomationProperties.Name" Value="{DynamicResource ui.winRestore}"/>
    <Setter TargetName="maxGlyph" Property="Visibility" Value="Collapsed"/><Setter TargetName="restoreGlyph" Property="Visibility" Value="Visible"/>
   </Trigger>
   <Trigger Property="ResizeMode" Value="NoResize"><Setter TargetName="frameMin" Property="Visibility" Value="Collapsed"/><Setter TargetName="frameMax" Property="Visibility" Value="Collapsed"/></Trigger>
  </ControlTemplate.Triggers>
 </ControlTemplate>

 <Style TargetType="TextBox">
  <Setter Property="Background" Value="#FEFEFF"/><Setter Property="BorderBrush" Value="#CCCFDA"/><Setter Property="BorderThickness" Value="1"/>
  <Setter Property="Padding" Value="11,7"/><Setter Property="VerticalContentAlignment" Value="Center"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
   <Border x:Name="field" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
    <ScrollViewer x:Name="PART_ContentHost" Margin="1" Focusable="False"/>
   </Border>
   <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="field" Property="BorderBrush" Value="#597CAE"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="field" Property="Opacity" Value=".55"/></Trigger></ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <ControlTemplate x:Key="bareText" TargetType="TextBox"><Border Background="Transparent"><ScrollViewer x:Name="PART_ContentHost" Focusable="False"/></Border></ControlTemplate>
 <Style TargetType="ComboBox">
  <Setter Property="Background" Value="#FEFEFF"/><Setter Property="Padding" Value="9,4"/><Setter Property="BorderThickness" Value="1"/>
  <Setter Property="BorderBrush" Value="#CCCFDA"/><Setter Property="MaxDropDownHeight" Value="310"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
   <Grid>
    <Border x:Name="MotionSurface" CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" RenderTransformOrigin=".5,.5">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
      <ContentPresenter x:Name="selected" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="{TemplateBinding Padding}" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"/>
      <Path Grid.Column="1" Data="M0,0 L3.5,3.5 L7,0" Stroke="#637086" StrokeThickness="1.4" StrokeLineJoin="Round" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False"/>
      <ToggleButton Grid.ColumnSpan="2" Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}">
       <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"/></ControlTemplate></ToggleButton.Template>
      </ToggleButton>
      <TextBox x:Name="PART_EditableTextBox" Visibility="Collapsed" Padding="{TemplateBinding Padding}" IsReadOnly="{TemplateBinding IsReadOnly}" Template="{StaticResource bareText}" VerticalContentAlignment="Center"/>
     </Grid>
    </Border>
    <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom" Focusable="False" IsOpen="{Binding IsDropDownOpen,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}">
     <Border x:Name="options" MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}" Margin="0,3" CornerRadius="14" Padding="5" Background="#FCFCFE" BorderBrush="#C9CEDA" BorderThickness="1">
      <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
     </Border>
    </Popup>
   </Grid>
   <ControlTemplate.Triggers>
    <Trigger Property="IsEditable" Value="True"><Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/><Setter TargetName="selected" Property="Visibility" Value="Hidden"/></Trigger>
    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="MotionSurface" Property="BorderBrush" Value="#597CAE"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="MotionSurface" Property="Opacity" Value=".5"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="ComboBoxItem">
  <Setter Property="Padding" Value="9,5"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
   <Border x:Name="MotionSurface" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsSelected" Value="True"><Setter TargetName="MotionSurface" Property="Background" Value="#E1E8F5"/></Trigger>
    <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="MotionSurface" Property="Background" Value="#E8ECF4"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="ListBox">
  <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/><Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBox">
   <Border CornerRadius="15" BorderBrush="#D5D8E0" BorderThickness="1" Background="#FDFDFE" Padding="6"><ScrollViewer Focusable="False"><ItemsPresenter/></ScrollViewer></Border>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="ListBoxItem">
  <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
   <Border x:Name="item" CornerRadius="8" Background="Transparent" Padding="3,0"><ContentPresenter/></Border>
   <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="item" Property="Background" Value="#E5EAF4"/></Trigger></ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="ContextMenu"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu">
  <Border Background="#FAFBFD" CornerRadius="13" BorderBrush="#CBCFDC" BorderThickness="1" Padding="5"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/></Border>
 </ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="MenuItem"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
  <Border x:Name="MotionSurface" Background="Transparent" CornerRadius="8" Padding="12,7"><ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/></Border>
  <ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="MotionSurface" Property="Background" Value="#E1E8F4"/></Trigger></ControlTemplate.Triggers>
 </ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="ToolTip"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToolTip">
  <Border CornerRadius="9" Background="#303542" Padding="9,5" TextElement.Foreground="White"><ContentPresenter/></Border>
 </ControlTemplate></Setter.Value></Setter></Style>
 <Style x:Key="payTabs" TargetType="TabControl">
  <Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></Setter.Value></Setter>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl">
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
    <ItemsPresenter KeyboardNavigation.TabIndex="1" KeyboardNavigation.DirectionalNavigation="Cycle"/>
    <ContentPresenter Grid.Row="1" x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" KeyboardNavigation.TabIndex="2"/>
   </Grid>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <ControlTemplate x:Key="dateCell" TargetType="Button">
  <Border x:Name="MotionSurface" CornerRadius="14" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}" Margin="1">
   <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
  </Border>
 </ControlTemplate>
 <Style x:Key="calendarAction" TargetType="Button">
  <Setter Property="Template" Value="{StaticResource glassButton}"/><Setter Property="Background" Value="#E8ECF5"/><Setter Property="Cursor" Value="Hand"/>
 </Style>
 <Style x:Key="dayCell" TargetType="CalendarDayButton">
  <Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="Normal"/>
  <Setter Property="Template" Value="{StaticResource dateCell}"/><Setter Property="Height" Value="29"/><Setter Property="MinWidth" Value="32"/>
  <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/>
  <Style.Triggers>
   <Trigger Property="IsInactive" Value="True"><Setter Property="Foreground" Value="#777D89"/></Trigger>
   <Trigger Property="IsToday" Value="True"><Setter Property="BorderBrush" Value="#8399B7"/></Trigger>
   <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#E8ECF5"/></Trigger>
   <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#466598"/><Setter Property="Foreground" Value="White"/></Trigger>
   <Trigger Property="IsBlackedOut" Value="True"><Setter Property="Opacity" Value=".4"/></Trigger>
   <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".4"/></Trigger>
  </Style.Triggers>
 </Style>
 <Style x:Key="monthCell" TargetType="CalendarButton">
  <Setter Property="FontSize" Value="13"/>
  <Setter Property="Template" Value="{StaticResource dateCell}"/><Setter Property="Padding" Value="5"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Background" Value="Transparent"/>
  <Style.Triggers>
   <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#E8ECF5"/></Trigger>
   <Trigger Property="HasSelectedDays" Value="True"><Setter Property="Background" Value="#DCE5F4"/></Trigger>
   <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".4"/></Trigger>
  </Style.Triggers>
 </Style>
 <Style x:Key="datePanel" TargetType="CalendarItem">
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CalendarItem">
   <ControlTemplate.Resources><DataTemplate x:Key="{x:Static CalendarItem.DayTitleTemplateResourceKey}"><TextBlock Text="{Binding}" HorizontalAlignment="Center" Foreground="#656E80" FontSize="11" Margin="0,5"/></DataTemplate></ControlTemplate.Resources>
   <Border x:Name="calendarPaper" Background="#FBFBFD" CornerRadius="16" BorderBrush="#CDD3DF" BorderThickness="1" Padding="9">
    <Grid x:Name="PART_Root" Width="245"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
     <DockPanel><Button DockPanel.Dock="Left" x:Name="PART_PreviousButton" Style="{StaticResource calendarAction}" Content="‹" Padding="8,3"/><Button DockPanel.Dock="Right" x:Name="PART_NextButton" Style="{StaticResource calendarAction}" Content="›" Padding="8,3"/><Button x:Name="PART_HeaderButton" Style="{StaticResource calendarAction}" Margin="5,0" Padding="4,3"/></DockPanel>
     <Grid Grid.Row="1" x:Name="PART_MonthView">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
     </Grid>
     <Grid Grid.Row="1" x:Name="PART_YearView" Visibility="Collapsed" MinHeight="170">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
     </Grid>
    </Grid>
   </Border>
   <ControlTemplate.Triggers>
    <DataTrigger Binding="{Binding DisplayMode,RelativeSource={RelativeSource AncestorType=Calendar}}" Value="Year"><Setter TargetName="PART_MonthView" Property="Visibility" Value="Collapsed"/><Setter TargetName="PART_YearView" Property="Visibility" Value="Visible"/></DataTrigger>
    <DataTrigger Binding="{Binding DisplayMode,RelativeSource={RelativeSource AncestorType=Calendar}}" Value="Decade"><Setter TargetName="PART_MonthView" Property="Visibility" Value="Collapsed"/><Setter TargetName="PART_YearView" Property="Visibility" Value="Visible"/></DataTrigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="dateCalendar" TargetType="Calendar">
  <Setter Property="FontFamily" Value="{StaticResource deskFont}"/><Setter Property="FontSize" Value="14"/>
  <Setter Property="CalendarItemStyle" Value="{StaticResource datePanel}"/><Setter Property="CalendarButtonStyle" Value="{StaticResource monthCell}"/><Setter Property="CalendarDayButtonStyle" Value="{StaticResource dayCell}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Calendar"><StackPanel x:Name="PART_Root"><CalendarItem x:Name="PART_CalendarItem" Style="{TemplateBinding CalendarItemStyle}"/></StackPanel></ControlTemplate></Setter.Value></Setter>
 </Style>
 <ControlTemplate x:Key="dateText" TargetType="DatePickerTextBox">
  <Grid Background="Transparent">
   <ScrollViewer x:Name="PART_ContentHost" Focusable="False"/>
   <TextBlock x:Name="dateHint" Text="{DynamicResource ui.pickDate}" Foreground="#677282" IsHitTestVisible="False" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" Visibility="Collapsed"/>
  </Grid>
  <ControlTemplate.Triggers><Trigger Property="Text" Value=""><Setter TargetName="dateHint" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers>
 </ControlTemplate>
 <Style TargetType="DatePicker">
  <Setter Property="CalendarStyle" Value="{StaticResource dateCalendar}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DatePicker">
   <Grid x:Name="PART_Root"><Border x:Name="dateField" BorderThickness="1" BorderBrush="#CCCFDA" Background="#FEFEFF" CornerRadius="10" Padding="4,2">
    <Grid><Button x:Name="PART_Button" Cursor="Hand" HorizontalContentAlignment="Right" Padding="0,4,7,4" Background="Transparent" AutomationProperties.Name="{TemplateBinding AutomationProperties.Name}">
     <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="MotionSurface" CornerRadius="8" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Right" VerticalAlignment="Center"/></Border>
      <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="MotionSurface" Property="Background" Value="#EDF0F7"/></Trigger></ControlTemplate.Triggers>
     </ControlTemplate></Button.Template>
     <Path Stroke="#586D91" StrokeThickness="1.4" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M2,3 Q1,3 1,5 V12 Q1,14 3,14 H12 Q14,14 14,12 V5 Q14,3 12,3 Z M4,1 V5 M10,1 V5 M2,7 H13"/>
    </Button><DatePickerTextBox x:Name="PART_TextBox" Template="{StaticResource dateText}" Padding="6,2" Margin="0,0,26,0" VerticalContentAlignment="Center" IsReadOnly="True" Focusable="False" IsHitTestVisible="False"/></Grid>
   </Border><Popup x:Name="PART_Popup" Placement="Bottom" PlacementTarget="{Binding ElementName=PART_Root}" AllowsTransparency="True" StaysOpen="False" VerticalOffset="3"/></Grid>
   <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="dateField" Property="BorderBrush" Value="#597CAE"/></Trigger></ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>

 <ControlTemplate x:Key="scrollStep" TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
 <ControlTemplate x:Key="scrollArrow" TargetType="RepeatButton">
  <Border x:Name="MotionSurface" Background="Transparent" CornerRadius="6"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
  <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="MotionSurface" Property="Background" Value="#E4E9F3"/></Trigger></ControlTemplate.Triggers>
 </ControlTemplate>
 <Style TargetType="ScrollBar">
  <Setter Property="Width" Value="12"/><Setter Property="MinHeight" Value="12"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
   <DockPanel Background="Transparent">
    <RepeatButton x:Name="lineBack" DockPanel.Dock="Top" Focusable="False" Width="12" Height="12" Command="{x:Static ScrollBar.LineUpCommand}" Template="{StaticResource scrollArrow}"><Path Data="M0,3 L3,0 L6,3" Stroke="#7A8699" StrokeThickness="1.3" StrokeLineJoin="Round"/></RepeatButton>
    <RepeatButton x:Name="lineNext" DockPanel.Dock="Bottom" Focusable="False" Width="12" Height="12" Command="{x:Static ScrollBar.LineDownCommand}" Template="{StaticResource scrollArrow}"><Path Data="M0,0 L3,3 L6,0" Stroke="#7A8699" StrokeThickness="1.3" StrokeLineJoin="Round"/></RepeatButton>
    <Track x:Name="PART_Track" IsDirectionReversed="True">
    <Track.DecreaseRepeatButton><RepeatButton x:Name="decrease" Command="{x:Static ScrollBar.PageUpCommand}" Template="{StaticResource scrollStep}" Focusable="False"/></Track.DecreaseRepeatButton>
    <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="thumb" Margin="2" CornerRadius="8" Background="#B0B8C7"/><ControlTemplate.Triggers><Trigger Property="IsDragging" Value="True"><Setter TargetName="thumb" Property="Background" Value="#7B89A2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
    <Track.IncreaseRepeatButton><RepeatButton x:Name="increase" Command="{x:Static ScrollBar.PageDownCommand}" Template="{StaticResource scrollStep}" Focusable="False"/></Track.IncreaseRepeatButton>
   </Track></DockPanel>
   <ControlTemplate.Triggers><Trigger Property="Orientation" Value="Horizontal">
    <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/><Setter TargetName="decrease" Property="Command" Value="{x:Static ScrollBar.PageLeftCommand}"/><Setter TargetName="increase" Property="Command" Value="{x:Static ScrollBar.PageRightCommand}"/>
    <Setter TargetName="lineBack" Property="DockPanel.Dock" Value="Left"/><Setter TargetName="lineNext" Property="DockPanel.Dock" Value="Right"/>
    <Setter TargetName="lineBack" Property="Command" Value="{x:Static ScrollBar.LineLeftCommand}"/><Setter TargetName="lineNext" Property="Command" Value="{x:Static ScrollBar.LineRightCommand}"/>
    <Setter TargetName="lineBack" Property="LayoutTransform"><Setter.Value><RotateTransform Angle="-90"/></Setter.Value></Setter>
