<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="{DynamicResource ui.appTitle}" Width="1020" Height="700" MinWidth="730" MinHeight="560" WindowStartupLocation="CenterScreen" Background="#F6F6F8" Foreground="#21232A" FontFamily="{DynamicResource deskFont}" FontWeight="Medium" FontSize="14" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
 <Window.Resources>
  <RadialGradientBrush x:Key="analogStage" Center=".48,.38" GradientOrigin=".28,.13" RadiusX=".95" RadiusY="1"><GradientStop Color="#F8F5EE"/><GradientStop Color="#E5E0D6" Offset=".58"/><GradientStop Color="#CDCAC0" Offset="1"/></RadialGradientBrush>
  <RadialGradientBrush x:Key="digitalStage" Center=".38,.35" GradientOrigin=".26,.20" RadiusX=".86" RadiusY=".94"><GradientStop Color="#4C5261"/><GradientStop Color="#303543" Offset=".48"/><GradientStop Color="#191C25" Offset="1"/></RadialGradientBrush>
  <ControlTemplate x:Key="listAction" TargetType="Button">
    <Grid Background="Transparent">
     <Grid x:Name="MotionSurface" RenderTransformOrigin=".5,.5">
      <Border CornerRadius="11" Background="{TemplateBinding Background}"/>
      <Border x:Name="MotionTint" CornerRadius="11" Background="#9BAAC7" Opacity="0" IsHitTestVisible="False"/>
      <Border Padding="{TemplateBinding Padding}"><ContentPresenter RecognizesAccessKey="True" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border>
     </Grid>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="MotionSurface" Property="Opacity" Value=".48"/></Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
  <Style TargetType="CheckBox">
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Cursor" Value="Hand"/><Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
    <Grid x:Name="checkRoot" Background="Transparent">
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Grid Width="24" Height="24" VerticalAlignment="Center">
      <Ellipse x:Name="focusRing" Margin=".5" Stroke="#6B80A8" StrokeThickness="1" Opacity="0"/>
      <Grid x:Name="MotionSurface" Width="18" Height="18" RenderTransformOrigin=".5,.5">
       <Ellipse Fill="#FDFDFF" Stroke="#838A98" StrokeThickness="1.4"/>
       <Ellipse x:Name="MotionTint" Fill="#91A7CF" Opacity="0"/>
       <Grid x:Name="SelectionInk" Opacity="0" IsHitTestVisible="False">
        <Ellipse Fill="#466598"/>
        <Path x:Name="tick" Data="M4.5,9 L7.7,12.2 L13.6,5.9" Stroke="White" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
       </Grid>
      </Grid>
     </Grid>
     <ContentPresenter Grid.Column="1" Margin="6,0,0,0" RecognizesAccessKey="True" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="SelectionInk" Property="Opacity" Value="1"/></Trigger>
     <Trigger Property="IsChecked" Value="{x:Null}"><Setter TargetName="SelectionInk" Property="Opacity" Value="1"/><Setter TargetName="tick" Property="Data" Value="M5,9 L13,9"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="focusRing" Property="Opacity" Value="1"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="checkRoot" Property="Opacity" Value=".45"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>

  <Style x:Key="payTab" TargetType="TabItem">
   <Setter Property="Margin" Value="0,0,4,6"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
    <Border x:Name="MotionSurface" CornerRadius="11" Background="#E8E9ED" Padding="15,8">
     <ContentPresenter x:Name="caption" ContentSource="Header" RecognizesAccessKey="True" TextElement.Foreground="#4B5261"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="MotionSurface" Property="Background" Value="#405A87"/><Setter TargetName="caption" Property="TextElement.Foreground" Value="White"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="section" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="20"/><Setter Property="Padding" Value="26"/></Style>
  <Style x:Key="heading" TargetType="TextBlock"><Setter Property="FontSize" Value="35"/><Setter Property="FontWeight" Value="Bold"/></Style>
 </Window.Resources>
 <Grid><Grid Margin="32,22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
 <DockPanel>
  <Button x:Name="Back" DockPanel.Dock="Right" Margin="12,0,0,0" Padding="13,6" VerticalAlignment="Center" Visibility="{Binding Visibility,ElementName=PageBar}" Content="{DynamicResource ui.back}" AutomationProperties.Name="{DynamicResource ui.back}">
   <Button.ContentTemplate><DataTemplate><StackPanel Orientation="Horizontal" VerticalAlignment="Center">
    <Path Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M2,9 L9,3 L16,9 M4,8 V15 Q4,16 5,16 H7.4 V11 H10.6 V16 H13 Q14,16 14,15 V8"/>
    <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
   </StackPanel></DataTemplate></Button.ContentTemplate>
  </Button>
  <ComboBox x:Name="LanguagePicker" DockPanel.Dock="Right" Width="98" Height="26" Margin="14,0,0,0" VerticalContentAlignment="Center" ToolTip="语言 / Language" AutomationProperties.Name="语言 / Language"><ComboBoxItem Tag="zh-CN" Content="简体中文"/><ComboBoxItem Tag="en-US" Content="English"/></ComboBox><CheckBox x:Name="Pin" DockPanel.Dock="Right" VerticalAlignment="Center" Content="{DynamicResource ui.pin}"/><TextBlock x:Name="DateLabel" DockPanel.Dock="Right" Foreground="#676974" VerticalAlignment="Center" Margin="0,0,20,0"/><StackPanel Orientation="Horizontal"><Border Background="#30343D" CornerRadius="11" Width="32" Height="32"><Path Stroke="White" StrokeThickness="2" Data="M8 19 Q13 19 15 11 M13 23 Q21 19 23 9 M20 23 L24 19"/></Border><TextBlock Text="{DynamicResource ui.brand}" FontSize="18" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel></DockPanel>
 <Grid x:Name="Host" Grid.Row="1" Margin="0,24,0,4"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
 <DockPanel x:Name="PageBar" Margin="0,0,0,18"><Button x:Name="Compact" Content="{DynamicResource ui.widgetOpen}" ToolTip="{DynamicResource ui.widgetToggleTip}" DockPanel.Dock="Right" Background="#323B50" Foreground="#FFFFFF" Margin="8,0,0,0" VerticalAlignment="Center"/><TextBlock x:Name="Heading" Style="{StaticResource heading}"/></DockPanel>
 <Grid Grid.Row="1">
 <Grid x:Name="Home">
  <Grid x:Name="CoverPanel" Background="#34353B" ClipToBounds="True">
   <Grid.ColumnDefinitions><ColumnDefinition Width=".93*"/><ColumnDefinition Width="1.07*"/></Grid.ColumnDefinitions>
   <Rectangle x:Name="Cover" Grid.ColumnSpan="2" IsHitTestVisible="False"/>
   <Grid x:Name="HomeFrost" Grid.ColumnSpan="2" IsHitTestVisible="False">
    <Rectangle Fill="{Binding Fill,ElementName=Cover}">
     <Rectangle.Effect><BlurEffect Radius="22"/></Rectangle.Effect>
     <Rectangle.CacheMode><BitmapCache RenderAtScale=".5"/></Rectangle.CacheMode>
    </Rectangle>
   </Grid>
   <Border x:Name="DateGlass" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="22,0,0,22" Padding="18,12,20,12"
           CornerRadius="22" BorderThickness="1" BorderBrush="{DynamicResource glassRim}">
    <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint=".8,1"><GradientStop Color="#AC47505B"/><GradientStop Color="#A1252B35" Offset="1"/></LinearGradientBrush></Border.Background>
    <StackPanel><TextBlock x:Name="IssueMonth" FontSize="15" FontWeight="SemiBold" Foreground="#F7F8FB"/>
     <TextBlock x:Name="IssueDay" FontSize="66" FontWeight="SemiBold" Foreground="White" LineHeight="72" LineStackingStrategy="BlockLineHeight"/></StackPanel>
   </Border>
   <Border x:Name="DeskGlass" Grid.Column="1" Margin="0,16,18,16" MaxHeight="392" Padding="20,18"
           CornerRadius="25" BorderThickness="1" BorderBrush="{DynamicResource glassRim}">
    <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint=".8,1"><GradientStop Color="#C8FFFFFF"/><GradientStop Color="#A8E0E6EF" Offset=".53"/><GradientStop Color="#BFDCE4EF" Offset="1"/></LinearGradientBrush></Border.Background>
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock Text="{DynamicResource ui.homeTitle}" FontSize="34" FontWeight="Bold" Foreground="#202734" Margin="3,0,0,13"/>
     <ScrollViewer x:Name="HomeToolsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel x:Name="Launchers" Margin="3,0"/>
     </ScrollViewer>
     <Border Grid.Row="2" Padding="2,10,2,0" Margin="0,5,0,0" BorderThickness="0,1,0,0" BorderBrush="#648796A9">
      <DockPanel><Button x:Name="OnlyWidgets" DockPanel.Dock="Right" Content="{DynamicResource ui.onlyWidgets}" Padding="11,6" Margin="8,0,0,0" ToolTip="{DynamicResource ui.onlyWidgetsTip}"/>
       <StackPanel VerticalAlignment="Center"><TextBlock Text="{DynamicResource ui.localTime}" Foreground="#3E4858" FontSize="12" FontWeight="SemiBold"/>
        <TextBlock x:Name="LocalTime" Foreground="#202735" FontSize="18" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular"/></StackPanel>
      </DockPanel>
     </Border>
    </Grid>
   </Border>
  </Grid>
 </Grid>
 <Grid x:Name="Payroll" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="2*"/><RowDefinition Height="10"/><RowDefinition Height="*"/></Grid.RowDefinitions>
 <Border Style="{StaticResource section}" Background="#272B39"><Grid><StackPanel VerticalAlignment="Center"><TextBlock Text="{DynamicResource ui.earned}" Foreground="#D2DAEE" FontSize="18"/><Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left" MaxHeight="108"><TextBlock x:Name="Amount" FontSize="76" FontWeight="SemiBold" Foreground="#F8FAFF"/></Viewbox><TextBlock x:Name="Rate" Foreground="#D6DBE9" FontSize="16"/></StackPanel><Button x:Name="Settings" Content="{DynamicResource ui.paySettings}" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#E3E9F7"/></Grid></Border>
 <Border Grid.Row="2" Style="{StaticResource section}"><DockPanel VerticalAlignment="Center"><TextBlock x:Name="Countdown" DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="24"/><StackPanel><TextBlock Text="{DynamicResource ui.todayShift}" Foreground="#696C76"/><TextBlock x:Name="Shift" FontSize="25" FontWeight="SemiBold"/></StackPanel></DockPanel></Border></Grid>
 <Grid x:Name="World" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
 <DockPanel Margin="0,0,0,12"><Button x:Name="MiniPlaces" Content="{DynamicResource ui.miniPlaces}" DockPanel.Dock="Right" Margin="6,0,0,0"/><Button x:Name="Zones" DockPanel.Dock="Right" Content="{DynamicResource ui.manageButton}"/><StackPanel Orientation="Horizontal"><Button x:Name="Analog" Content="{DynamicResource ui.analog}"/><Button x:Name="Digital" Margin="5,0" Content="{DynamicResource ui.digital}"/><Button x:Name="ListOnly" Content="{DynamicResource ui.listOnly}"/></StackPanel></DockPanel>
 <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
 <Border x:Name="ClockHero" CornerRadius="20" Background="{StaticResource analogStage}">
 <Grid Margin="18"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><Image x:Name="DigitalFlag" Width="238" MaxHeight="180" Stretch="Uniform" Opacity=".40" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality"><Image.OpacityMask><LinearGradientBrush StartPoint="0,0" EndPoint=".9,1"><GradientStop Color="White" Offset=".08"/><GradientStop Color="#24FFFFFF" Offset="1"/></LinearGradientBrush></Image.OpacityMask></Image><Grid x:Name="DialHost"/><Viewbox x:Name="DigitalHost" Margin="12" StretchDirection="DownOnly"><TextBlock x:Name="DigitalTime" Foreground="#F2EEFF" FontSize="66" FontWeight="SemiBold"/></Viewbox></Grid>
 <Grid Grid.Row="1" Margin="2,7,2,3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
  <StackPanel x:Name="ClockCaption" VerticalAlignment="Center" Margin="0,0,6,0"><TextBlock x:Name="CityTitle" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="CityDate" FontSize="12"/></StackPanel>
  <StackPanel x:Name="DialDesignControl" Grid.Column="1"><TextBlock Text="{DynamicResource ui.dialDesign}" FontSize="11" Foreground="#585D68" Margin="3,0,0,3"/><ComboBox x:Name="DialDesignPicker" Width="134" Height="32" Padding="6,2" AutomationProperties.Name="{DynamicResource ui.dialDesign}"/></StackPanel>
 </Grid></Grid></Border>
 <Border x:Name="ClockListPanel" Grid.Column="2" Style="{StaticResource section}" Padding="14"><DockPanel><TextBlock Text="{DynamicResource ui.myPlaces}" DockPanel.Dock="Top" FontSize="18" FontWeight="SemiBold" Margin="6,2,0,12"/><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="Clocks"/></ScrollViewer></DockPanel></Border>
 </Grid></Grid>
 <Grid x:Name="TodoPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="12"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <Border Style="{StaticResource section}"><DockPanel><DockPanel DockPanel.Dock="Top" Margin="0,0,0,12"><Button x:Name="TaskHistory" Content="{DynamicResource ui.taskHistory}" DockPanel.Dock="Right"/><TextBlock x:Name="TaskCount" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel><DockPanel DockPanel.Dock="Top" Margin="0,0,0,16"><Button x:Name="AddTask" Content="{DynamicResource ui.add}" DockPanel.Dock="Right" Margin="10,0,0,0"/><Button x:Name="PlanTask" Content="{DynamicResource ui.planTask}" DockPanel.Dock="Right" Margin="8,0,0,0"/><TextBox x:Name="TaskEntry" MaxLength="240" ToolTip="{DynamicResource ui.taskTip}" AutomationProperties.Name="{DynamicResource ui.newTask}"/></DockPanel><Grid><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="Tasks"/></ScrollViewer><TextBlock x:Name="Empty" Text="{DynamicResource ui.emptyTasks}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#70727B"/></Grid></DockPanel></Border>
 <Border Grid.Row="2" Style="{StaticResource section}" Background="#E8E8EE" Padding="20,14"><DockPanel><Button x:Name="ResetFocus" Content="{DynamicResource ui.reset}" DockPanel.Dock="Right" Background="#F9F4F1"/><Button x:Name="StartFocus" Content="{DynamicResource ui.startFocus}" DockPanel.Dock="Right" Margin="5,0" Background="#383844" Foreground="White"/><TextBlock x:Name="FocusTime" DockPanel.Dock="Right" FontSize="25" Margin="12,0"/><TextBlock x:Name="FocusLabel" VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold"/></DockPanel></Border></Grid>
 </Grid></Grid></Grid>
<Image x:Name="Signature" AutomationProperties.Name="三木" IsHitTestVisible="False" Focusable="False" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,15,3" Width="21" Height="21" Opacity=".34" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/></Grid>
</Window>
