<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="日序 · 桌面助手" Width="1020" Height="700" MinWidth="730" MinHeight="560" WindowStartupLocation="CenterScreen" Background="#F7F6F1" Foreground="#21232A" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Background" Value="#E9E8DF"/><Setter Property="Padding" Value="16,9"/><Setter Property="Foreground" Value="#24262E"/><Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Center"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="chip" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="6" RenderTransformOrigin=".5,.5"><Border.RenderTransform><ScaleTransform/></Border.RenderTransform><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="chip" Property="Opacity" Value=".9"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="chip" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX=".97" ScaleY=".97"/></Setter.Value></Setter></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="11,8"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="BorderBrush" Value="#D5D6DE"/></Style>
  <Style x:Key="section" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="6"/><Setter Property="Padding" Value="26"/></Style>
  <Style x:Key="heading" TargetType="TextBlock"><Setter Property="FontSize" Value="35"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
 </Window.Resources>
 <Grid Margin="32,22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
 <DockPanel><CheckBox x:Name="Pin" DockPanel.Dock="Right" VerticalAlignment="Center" Content="置顶"><CheckBox.Template><ControlTemplate TargetType="CheckBox"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border x:Name="Track" CornerRadius="7" Height="14" Width="26" Background="#BCBEB3"><Ellipse x:Name="Knob" HorizontalAlignment="Left" Width="10" Height="10" Fill="White" Margin="2"/></Border><TextBlock Text="置顶" Margin="6,0,0,0"/></StackPanel><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="#405541"/><Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/></Trigger></ControlTemplate.Triggers></ControlTemplate></CheckBox.Template></CheckBox><TextBlock x:Name="DateLabel" DockPanel.Dock="Right" Foreground="#676974" VerticalAlignment="Center" Margin="0,0,20,0"/><StackPanel Orientation="Horizontal"><Border Background="#323B34" CornerRadius="9" Width="32" Height="32"><Path Stroke="White" StrokeThickness="2" Data="M8 19 Q13 19 15 11 M13 23 Q21 19 23 9 M20 23 L24 19"/></Border><TextBlock Text="日序" FontSize="18" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel></DockPanel>
 <Grid x:Name="Host" Grid.Row="1" Margin="0,24,0,4"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
 <DockPanel x:Name="PageBar" Margin="0,0,0,18"><Button x:Name="Compact" Content="缩小模式" ToolTip="将当前工具收起为桌面小窗" DockPanel.Dock="Right" Background="#303B34" Foreground="#FFFFFF" Margin="8,0,0,0" VerticalAlignment="Center"/><Button x:Name="Back" Content="‹   工具主页" DockPanel.Dock="Right" VerticalAlignment="Center"/><TextBlock x:Name="Heading" Style="{StaticResource heading}"/></DockPanel>
 <Grid Grid.Row="1">
 <Grid x:Name="Home">
 <Grid.ColumnDefinitions><ColumnDefinition Width="1.04*"/><ColumnDefinition Width="0.08*"/><ColumnDefinition/></Grid.ColumnDefinitions>
 <Grid Background="#353732" ClipToBounds="True"><Image x:Name="Cover" Stretch="UniformToFill"/><Rectangle IsHitTestVisible="False"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00000000" Offset=".48"/><GradientStop Color="#B81D1C19" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
 <StackPanel VerticalAlignment="Bottom" Margin="24,0,12,27"><TextBlock x:Name="IssueMonth" FontFamily="Georgia" FontSize="17" Foreground="#FFFDF4"/><TextBlock x:Name="IssueDay" FontFamily="Georgia" FontSize="92" Foreground="#FFFDF4" LineHeight="98" LineStackingStrategy="BlockLineHeight"/></StackPanel></Grid>
 <Grid Grid.Column="2" Margin="0,14,6,14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <StackPanel><TextBlock Text="我的工作台" FontFamily="STZhongsong, SimSun" FontSize="39" Margin="0,8,0,18"/><Border Background="#3D443E" Height="2"/></StackPanel>
 <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="Launchers"/></ScrollViewer>
 <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="#C9C9BD" Padding="0,12,0,0"><DockPanel><TextBlock Text="本地时间" Foreground="#676960"/><TextBlock x:Name="LocalTime" TextAlignment="Right" FontFamily="Consolas" FontSize="17"/></DockPanel></Border></Grid></Grid>
 <Grid x:Name="Payroll" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="2*"/><RowDefinition Height="10"/><RowDefinition Height="*"/></Grid.RowDefinitions>
 <Border Style="{StaticResource section}" Background="#25332F"><Grid><StackPanel VerticalAlignment="Center"><TextBlock Text="今日预计已赚" Foreground="#C7E5CF" FontSize="18"/><Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left" MaxHeight="108"><TextBlock x:Name="Amount" FontSize="76" FontWeight="Light" Foreground="#F3FFEC"/></Viewbox><TextBlock x:Name="Rate" Foreground="#CAE4D4" FontSize="16"/></StackPanel><Button x:Name="Settings" Content="薪资设置" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#D9EDDF"/></Grid></Border>
 <Border Grid.Row="2" Style="{StaticResource section}"><DockPanel VerticalAlignment="Center"><TextBlock x:Name="Countdown" DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="24"/><StackPanel><TextBlock Text="今日班次" Foreground="#696C76"/><TextBlock x:Name="Shift" FontSize="25" FontWeight="SemiBold"/></StackPanel></DockPanel></Border></Grid>
 <Grid x:Name="World" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
 <DockPanel Margin="0,0,0,12"><Button x:Name="MiniPlaces" Content="小窗地点" DockPanel.Dock="Right" Margin="6,0,0,0"/><Button x:Name="Zones" DockPanel.Dock="Right" Content="＋  管理地点"/><StackPanel Orientation="Horizontal"><Button x:Name="Analog" Content="指针表盘"/><Button x:Name="Digital" Margin="5,0" Content="电子时钟"/></StackPanel></DockPanel>
 <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
 <Border CornerRadius="6"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#34372F"/><GradientStop Color="#151A18" Offset="1"/></LinearGradientBrush></Border.Background>
 <Grid Margin="18"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><Grid x:Name="DialHost"/><Viewbox x:Name="DigitalHost" Margin="12" StretchDirection="DownOnly"><TextBlock x:Name="DigitalTime" Foreground="#F2EEFF" FontSize="66" FontWeight="Light"/></Viewbox></Grid>
 <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,10,0,5"><TextBlock x:Name="CityTitle" Foreground="White" TextAlignment="Center" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="CityDate" Foreground="#BEC4D9" TextAlignment="Center"/></StackPanel></Grid></Border>
 <Border Grid.Column="2" Style="{StaticResource section}" Padding="14"><DockPanel><TextBlock Text="我的地点" DockPanel.Dock="Top" FontSize="18" FontWeight="SemiBold" Margin="6,2,0,12"/><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="Clocks"/></ScrollViewer></DockPanel></Border>
 </Grid></Grid>
 <Grid x:Name="TodoPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="12"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <Border Style="{StaticResource section}"><DockPanel><TextBlock x:Name="TaskCount" DockPanel.Dock="Top" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14"/><DockPanel DockPanel.Dock="Top" Margin="0,0,0,16"><Button x:Name="AddTask" Content="添加" DockPanel.Dock="Right" Margin="10,0,0,0"/><TextBox x:Name="TaskEntry" MaxLength="240" ToolTip="输入待办，回车添加" AutomationProperties.Name="新待办"/></DockPanel><Grid><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="Tasks"/></ScrollViewer><TextBlock x:Name="Empty" Text="写下今天的第一件待办。" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#70727B"/></Grid></DockPanel></Border>
 <Border Grid.Row="2" Style="{StaticResource section}" Background="#E9E5D7" Padding="20,14"><DockPanel><Button x:Name="ResetFocus" Content="重置" DockPanel.Dock="Right" Background="#F9F4F1"/><Button x:Name="StartFocus" Content="开始专注" DockPanel.Dock="Right" Margin="5,0" Background="#37302D" Foreground="White"/><TextBlock x:Name="FocusTime" DockPanel.Dock="Right" FontSize="25" Margin="12,0"/><TextBlock x:Name="FocusLabel" VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold"/></DockPanel></Border></Grid>
 </Grid></Grid></Grid>
</Window>



